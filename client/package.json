{
  "name": "kumo_ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "vp lint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "auth generate --output db/auth-schema.ts --config lib/auth.ts",
    "openui:generate": "openui generate lib/openui/library.tsx --out lib/openui/generated/system-prompt.txt --no-interactive",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.102",
    "@base-ui/react": "^1.8.0",
    "@cloudflare/kumo": "^2.13.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.20.6",
    "@openuidev/react-lang": "^1.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "^9.2.4",
    "ai": "^7.0.99",
    "better-auth": "^1.7.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "lz-string": "^1.5.0",
    "marked": "^18.0.12",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@openuidev/cli": "^0.6.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-plus": "catalog:",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@11.11.0"
}

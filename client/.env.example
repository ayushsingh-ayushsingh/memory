# ---------------------------------------------------------------------------
# Client (Next.js) — copy to .env.local and fill in secrets
# ---------------------------------------------------------------------------

# Better Auth: 32+ char secret. Generate with: openssl rand -base64 32
# MUST match the backend's expectation only indirectly (backend uses JWKS,
# not this secret) — but keep it stable or sessions/JWKS keys break.
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# OAuth providers (GitHub + Google only)
# GitHub: https://github.com/settings/developers — callback:
#   http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials — callback:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SQLite database shared at the project root (chat_app/data/app.db).
# Optional override; relative paths resolve from chat_app/client.
# DATABASE_URL=../data/app.db

# Python backend (FastAPI)
PYTHON_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_PYTHON_BACKEND_URL=http://localhost:8000

{
  "root": "Stack",
  "components": {
    "Stack": {
      "signature": "Stack(items: (Heading | Text | List | Metric | Badge | Callout | Progress | Code | Table | Chart | Card)[], direction?: \"column\" | \"row\")",
      "description": "Root container. Stacks its items vertically (default) or in a wrapping row. Every program starts with `root = Stack([...])`."
    },
    "Card": {
      "signature": "Card(title: string, items: (Heading | Text | List | Metric | Badge | Callout | Progress | Code | Table | Chart)[])",
      "description": "A titled card that groups a few components of the answer together."
    },
    "Heading": {
      "signature": "Heading(text: string)",
      "description": "Section title for the answer. Use once at the top of a program, not for every line."
    },
    "Text": {
      "signature": "Text(content: string, tone?: \"default\" | \"subtle\" | \"success\" | \"error\")",
      "description": "A short paragraph of prose. Plain sentences only — no markdown, no headings, no lists."
    },
    "List": {
      "signature": "List(items: string[])",
      "description": "Bulleted list of short items, one per line."
    },
    "Metric": {
      "signature": "Metric(label: string, value: string | number, hint?: string)",
      "description": "One key number with its label and an optional change note. Group several in a Stack row for a KPI strip."
    },
    "Badge": {
      "signature": "Badge(label: string, tone?: \"neutral\" | \"info\" | \"success\" | \"warning\" | \"danger\")",
      "description": "Small status label, for example next to a heading or inside a table cell."
    },
    "Callout": {
      "signature": "Callout(title: string, body?: string, tone?: \"neutral\" | \"info\" | \"success\" | \"warning\" | \"danger\")",
      "description": "Highlighted note for a warning, an error, a success or a tip."
    },
    "Progress": {
      "signature": "Progress(label: string, value: number, max?: number, customValue?: string)",
      "description": "A single value against a maximum, drawn as a progress bar. Use `value` with a percentage `max` (default 100)."
    },
    "Code": {
      "signature": "Code(content: string)",
      "description": "A code or command block, shown verbatim in monospace. Use for short snippets only; Python programs belong in a marimo notebook instead."
    },
    "Table": {
      "signature": "Table(columns: string[], rows: (string | number)[][])",
      "description": "Rows and columns of values, for comparisons and lists of records. `rows` are strings or numbers, in the same order as `columns`."
    },
    "Chart": {
      "signature": "Chart(kind: \"area\" | \"bar\" | \"line\" | \"pie\", categories: string[], series: {name: string, values: number[]}[], title?: string)",
      "description": "An animated chart. `categories` are the x labels (or the slices of a pie) and each series holds one value per category, in the same order."
    }
  },
  "componentGroups": [
    {
      "components": [
        "Stack",
        "Card"
      ],
      "name": "Layout",
      "notes": [
        "- Stack is the root of every program. Use direction \"row\" for a strip of Metric components — it wraps on narrow screens.",
        "- Neither Stack nor Card may contain another Stack or Card inside; nest content, not layout."
      ]
    },
    {
      "components": [
        "Heading",
        "Text",
        "List",
        "Metric",
        "Badge",
        "Callout",
        "Code"
      ],
      "name": "Content",
      "notes": [
        "- Keep prose short and use the components instead of markdown.",
        "- A row of Metric components answers “what are the numbers?” faster than a paragraph."
      ]
    },
    {
      "components": [
        "Table",
        "Progress",
        "Chart"
      ],
      "name": "Data",
      "notes": [
        "- Table for exact values, Chart for shape over time (area, line, bar) or parts of a whole (pie).",
        "- Chart: every series needs exactly one value per category. Use a single series for pie.",
        "- Do not put a chart inside a row — charts need the full width."
      ]
    }
  ],

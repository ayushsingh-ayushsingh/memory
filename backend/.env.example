# Groq LLM (entity/relation extraction, conductor agent)
GROQ_API_KEY=your-groq-api-key

# Qdrant (chunk + fact vectors written by the DUL graph-RAG extract endpoint)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# FalkorDB (graph store used by Graphiti in the DUL graph-RAG module).
# Defaults shown; override only if the database runs elsewhere.
# FALKORDB_HOST=127.0.0.1
# FALKORDB_PORT=6379
# FALKORDB_USER=default
# FALKORDB_PASSWORD=password

# DUL graph-RAG tuning (all optional, sane defaults in
# dul_graph_rag/modules/settings.py — e.g. DUL_GROQ_MODEL, DUL_CHUNK_SIZE,
# DUL_FACT_COLLECTION, DUL_CHUNK_COLLECTION, DUL_REQUIRE_AUTH, ...)

# Frontend / CORS
FRONTEND_URL=http://localhost:3000

# Better Auth JWT verification (all routes except GET /health require a
# valid `Authorization: Bearer <jwt>` from the Next.js client).
# Verified statelessly via JWKS — no shared secret needed here.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:3000
